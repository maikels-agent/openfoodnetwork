%fieldset.no-border-bottom
  %legend{align: 'center'}= t('.title')

  - if @order.complete?
    .alpha.six.columns
      %p
        %b= t('.distributor')
        = @order.distributor&.name || t(:none)
        %input{type: "hidden", id: "order_distributor_id", value: @order.distributor&.id}
    .omega.six.columns
      %p
        %b= t('.order_cycle')
        = @order.order_cycle&.name || t(:none)
        %input{type: "hidden", id: "order_order_cycle_id", value: @order.order_cycle&.id}
  - else
    :ruby
      order_cycle_options = order_cycle_options_by_distributor(@shops, @order_cycles)
      current_order_cycle_options = order_cycle_options.to_h[@order.distributor_id] || []
      dependent_select = { controller: "dependent-select", "dependent-select-options-value": order_cycle_options.to_json }
    %div{ data: dependent_select }
      .alpha.six.columns
        .field
          = label_tag :order_distributor_id, t(:distributor)
          = select_tag "order[distributor_id]",
            options_for_select(distributor_options(@shops, order_cycle_options), @order.distributor_id),
            include_blank: true, class: "primary fullwidth",
            data: { controller: "tom-select", "dependent-select-target": "source", action: "dependent-select#handleSelectChange" }

      .omega.six.columns
        .field
          = label_tag :order_order_cycle_id, t(:order_cycle)
          = select_tag "order[order_cycle_id]",
            options_for_select(current_order_cycle_options, @order.order_cycle_id),
            include_blank: true, class: "primary fullwidth", disabled: current_order_cycle_options.empty?,
            data: { controller: "tom-select", "dependent-select-target": "select", action: "toggle-control#enableIfPresent" }
