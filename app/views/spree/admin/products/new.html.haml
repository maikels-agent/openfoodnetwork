= render :partial => 'spree/admin/shared/product_sub_menu'
= render :partial => 'spree/shared/error_messages', :locals => { :target => @product }

= form_for [:admin, @product], :html => { :multipart => true } do |f|
  .twelve.columns.alpha
    %fieldset.no-border-bottom{ id: "new_product", data: { controller: "edit-variant", "edit-variant-prefix-value": "product" } }
      %script= render partial: "admin/shared/global_var_ofn", formats: :js,
        locals: { name: :available_units_sorted, value: WeightsAndMeasures.available_units_sorted }

      %script= render partial: "admin/shared/global_var_ofn", formats: :js,
        locals: { name: :currency_config, value: Api::CurrencyConfigSerializer.new({}) }

      %legend{align: "center"}= t(".new_product")
      .sixteen.columns.alpha
        .eight.columns.alpha
          = f.field_container :enterprise_id do
            = f.label :enterprise_id, t(".enterprise")
            %span.required *
            = render(SearchableDropdownComponent.new(form: f,
                name: :enterprise_id,
                aria_label: t('.enterprise'),
                options: @producers.select(:name, :id).order(:name).pluck(:name, :id),
                selected_option: @product.enterprise_id,
                include_blank: true,
                placeholder_value: t('.search_for_enterprises')))
            = f.error_message_on :enterprise_id
        .eight.columns.omega
          = f.field_container :name do
            = f.label :name, t(".product_name")
            %span.required *
            %br/
            = f.text_field :name, :class => 'fullwidth title'
            = f.error_message_on :name
      .sixteen.columns.alpha
        .eight.columns.alpha
          = f.field_container :variant_unit do
            = label_tag :product_variant_unit_with_scale, t(".units")
            %span.required *
            = select_tag :product_variant_unit_with_scale,
              options_for_select(WeightsAndMeasures.variant_unit_options, product_variant_unit_with_scale(@product)),
              { include_blank: true,
                class: "primary",
                data: { controller: "tom-select", "tom-select-options-value": '{"allowEmptyOption":false}' } }
            = f.hidden_field :variant_unit
            = f.hidden_field :variant_unit_scale
            = f.error_message_on :variant_unit
        .two.columns
          = f.field_container :unit_value do
            = label_tag :product_unit_value_with_description, t(".value")
            %span.required *
            = text_field_tag :product_unit_value_with_description, product_unit_value_with_description(@product), placeholder: "eg. 2", class: 'fullwidth'
            = f.hidden_field :unit_value
            = f.hidden_field :unit_description
            = f.error_message_on :unit_value
        = render 'display_as', f: f
        .six.columns.omega{ data: { "edit-variant-target": "itemsOnly" }, style: ("display: none" unless @product.variant_unit == "items") }
          = f.field_container :variant_unit_name do
            = f.label :variant_unit_name, t(".unit_name")
            %span.required *
            = f.text_field :variant_unit_name,
               placeholder: t('admin.products.unit_name_placeholder'),
               class: 'fullwidth',
               maxlength: 20
            = f.error_message_on :variant_unit_name
      .sixteen.columns.alpha
        .eight.columns.alpha
          = render 'spree/admin/products/primary_taxon_form', f: f
        .four.columns
          = f.field_container :price do
            = f.label :price, t(".price")
            %span.required *
            %br/
            = f.text_field :price, class: "fullwidth"
            = f.error_message_on :price
        .four.columns
          = f.field_container :unit_price do
            %div{style: "display: flex"}
              = f.label :unit_price, t(".unit_price")
              = render TooltipComponent.new(text: t('js.admin.unit_price_tooltip'), element_text: "", element_class: "question-mark-icon")
            %input{ "type" => "text", "id" => "product_unit_price", "name" => "product[unit_price]",
                "class" => 'fullwidth', "disabled" =>  true }
            %div{style: "color: black"}
              = t(".unit_price_legend")
      .sixteen.columns.alpha
        .three.columns
          - if Spree::TaxCategory.any?
            = render 'spree/admin/products/tax_category_form', f: f
          - else
            &nbsp;
        .five.columns.omega
          = render 'spree/admin/products/shipping_category_form', f: f
        .five.columns
          = f.field_container :on_hand do
            = f.label :on_hand, t(".on_hand")
            %br/
            = f.text_field :on_hand, class: 'fullwidth', value: @on_hand
            = f.error_message_on :on_hand
        .three.columns.omega
          = f.field_container :on_demand do
            = f.label :on_demand, t(".on_demand")
            %br/
            = f.check_box :on_demand, value: '1', checked: @on_demand == '1'
            = f.error_message_on :on_demand

      .sixteen.columns.alpha
        = f.field_container :description do
          = f.label :product_description, t(".product_description")
          %br/
          = f.hidden_field :description, id: "product_description", value: @product.description
          %trix-editor{ input: "product_description", "data-controller": "trixeditor" }
          = f.error_message_on :description
  .four.columns.omega{ style: "text-align: center" }
    %fieldset.no-border-bottom{ id: "image" }
      %legend{align: "center"}= t(".image")
      .row
        = image_tag Spree::Image.default_image_url(:product), class: "four columns alpha"
      .row
        = f.fields_for 'image_attributes', f.object.build_image do |image_fields|
          = image_fields.file_field :attachment
  .sixteen.columns.alpha
    .form-buttons.filter-actions.actions
      = button t('actions.create'), 'icon-ok', :submit, value: "create"

      = button t('actions.create_and_add_another'), 'icon-repeat', :submit, value: 'add_another'

      = link_to_with_icon 'icon-remove', t('actions.cancel'), admin_products_path, :class => 'button'

