.stripe
  - content_for :stripe_js, flush: true do
    = render "shared/stripe_js"

  - if Stripe.publishable_key
    - param_prefix = "payment_source[#{payment_method.id}]"
    .row{ data: { controller: "stripe", "stripe-key": Stripe.publishable_key, "stripe-hide-postal-code-value": "false" } }
      = hidden_field_tag "#{param_prefix}[month]", nil, id: nil, data: { "stripe-target": "expMonth" }
      = hidden_field_tag "#{param_prefix}[year]", nil, id: nil, data: { "stripe-target": "expYear" }
      = hidden_field_tag "#{param_prefix}[cc_type]", nil, id: nil, data: { "stripe-target": "brand" }
      = hidden_field_tag "#{param_prefix}[last_digits]", nil, id: nil, data: { "stripe-target": "last4" }
      = hidden_field_tag "#{param_prefix}[gateway_payment_profile_id]", nil, id: nil, data: { "stripe-target": "pmId" }
      .three.columns
        = label_tag :card_details, t(:card_details)
      .nine.columns
        .card-element{ data: { "stripe-target": "cardElement" } }
        .error.card-errors{ data: { "stripe-target": "cardErrors" } }
