%fieldset.no-border-bottom#gateway_fields
  %legend{ align: "center"}
    = t(:provider_settings)
  .preference-settings{ data: { controller: "frame-loader", "frame-loader-url-value": main_app.status_admin_stripe_accounts_path, "frame-loader-param-value": "enterprise_id" } }
    - enterprise_id = @payment_method.preferred_enterprise_id.presence
    - enterprise_id = nil unless enterprise_id&.positive?
    = fields_for :payment_method, @payment_method do |payment_method_form|
      .row
        .alpha.four.columns
          = payment_method_form.label :stripe_account_owner
        .omega.twelve.columns
          - if @stripe_account_holder.nil? || spree_current_user.enterprises.include?(@stripe_account_holder)
            = payment_method_form.select :preferred_enterprise_id, options_from_collection_for_select(@hubs, :id, :name, enterprise_id), { include_blank: t(".enterprise_select_placeholder") }, class: "fullwidth", data: { controller: "tom-select", action: "change->frame-loader#load" }
          - else
            %strong= Enterprise.find_by(id: @payment_method)&.name

    %template{ data: { "frame-loader-target": "loading" } }
      .alert-box.warning
        = t(".loading_account_information_msg")

    %turbo-frame#stripe-account-status{ src: (main_app.status_admin_stripe_accounts_path(enterprise_id:) if enterprise_id), data: { "frame-loader-target": "frame" } }
      - if enterprise_id
        .alert-box.warning
          = t(".loading_account_information_msg")
