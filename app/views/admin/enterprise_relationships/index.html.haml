- content_for :page_title do
  = t 'admin_enterprise_relationships'

= render 'admin/shared/enterprises_sub_menu'

%div{ data: { controller: "filter-rows" } }
  = render 'search_input'

  = form_with url: admin_enterprise_relationships_path, id: "new_enterprise_relationship", data: { turbo: true }

  %table#enterprise-relationships
    %colgroup
      %col{ style: "width: 30%" }
      %col{ style: "width: 5%" }
      %col{ style: "width: 30%" }
      %col{ style: "width: 30%" }
      %col{ style: "width: 5%" }
    %tbody
      = render 'form'
      = render partial: 'enterprise_relationship', collection: @enterprise_relationships
