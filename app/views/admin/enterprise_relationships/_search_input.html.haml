%input.search{ placeholder: t(:admin_enterprise_relationships_seach_placeholder), data: { "filter-rows-target": "query", action: "input->filter-rows#filter" } }

- EnterpriseRelationshipPermission::ALL.each do |permission|
  %label
    %input{ type: "checkbox", data: { action: "filter-rows#toggleKeyword", "filter-rows-keyword-param": permission } }
    = enterprise_relationship_permission_name(permission)
