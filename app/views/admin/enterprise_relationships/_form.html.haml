%tr#enterprise_relationship_form
  %td
    = select_tag "enterprise_relationship[parent_id]", options_from_collection_for_select(@my_enterprises, :id, :name), include_blank: true, class: "select2 fullwidth", form: "new_enterprise_relationship"

  %td
    = t 'admin_enterprise_relationships_permits'
  %td
    = select_tag "enterprise_relationship[child_id]", options_from_collection_for_select(@all_enterprises, :id, :name), include_blank: true, class: "select2 fullwidth", form: "new_enterprise_relationship"
  %td{ data: { controller: "checked" } }
    %label
      %input{ type: "checkbox", data: { "checked-target": "all" } }
      = t 'admin_enterprise_relationships_everything'
    - EnterpriseRelationshipPermission::ALL.each do |permission|
      %div
        %label
          = check_box_tag "enterprise_relationship[permissions_list][]", permission, false, id: "enterprise_relationship_permissions_list_#{permission}", form: "new_enterprise_relationship", data: { "checked-target": "checkbox" }
          = t('admin_enterprise_relationships_to')
          = enterprise_relationship_permission_name(permission)
  %td.actions
    %input{ type: "submit", value: t(:admin_enterprise_relationships_button_create), form: "new_enterprise_relationship" }
    #enterprise_relationship_errors.errors
