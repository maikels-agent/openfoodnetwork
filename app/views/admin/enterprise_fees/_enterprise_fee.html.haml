- keywords = [enterprise_fee.name, enterprise_fee.enterprise&.name, enterprise_fee.fee_type, enterprise_fee.calculator&.description]
%tr{ data: { controller: "calculator-settings", "calculator-settings-original-value": enterprise_fee.calculator_type, "filter-rows-target": "row", "filter-rows-keywords": keywords.compact.join(" ") } }
  %td
    = f.hidden_field :id
    = f.collection_select :enterprise_id, @enterprises, :id, :name, { include_blank: enterprise_fee.enterprise_id.nil? }, style: "width: 90%"
  %td= f.select :fee_type, enterprise_fee_type_options, { include_blank: enterprise_fee.fee_type.nil? }
  %td= f.text_field :name, placeholder: t('admin.enterprise_fees.index.name_placeholder')
  %td= f.select :tax_category_id, enterprise_fee_tax_category_options(@tax_categories), { selected: enterprise_fee_tax_category_id(enterprise_fee), include_blank: enterprise_fee_tax_category_id(enterprise_fee).nil? }
  %td= f.select :calculator_type, @calculators.map { |calculator| [calculator.description, calculator.name] }, { include_blank: enterprise_fee.calculator_type.nil? }, class: "calculator_type", data: { action: "calculator-settings#toggle" }
  %td
    - if enterprise_fee.persisted? && enterprise_fee.calculator
      .calculator-settings{ data: { "calculator-settings-target": "settings" } }
        = f.fields_for :calculator do |calculator_form|
          - preference_fields(enterprise_fee.calculator, calculator_form).each do |field|
            %span.field
              = field[:label]
            %p.field
              = field[:field]
  %td.actions
    - if enterprise_fee.persisted?
      = deprecated_link_to_delete enterprise_fee, url: "/api/v0/enterprise_fees/#{enterprise_fee.id}", no_text: true
