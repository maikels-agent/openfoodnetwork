- if spree_current_user.admin?
  = render 'spree/admin/shared/configuration_menu'

= content_for :page_title do
  = t('.title')

= form_for @enterprise_fee_set, as: :sets_enterprise_fee_set, url: main_app.bulk_update_admin_enterprise_fees_path, html: { data: { controller: "filter-rows" } } do |enterprise_fee_set_form|
  = hidden_field_tag 'enterprise_id', @enterprise.id if @enterprise
  = render :partial => 'spree/shared/error_messages', :locals => { :target => @enterprise_fee_set }

  %input.search{ placeholder: t('.search'), data: { "filter-rows-target": "query", action: "input->filter-rows#filter" } }

  %table.index#listing_enterprise_fees
    %thead
      %tr
        %th
          = t('.enterprise')
        %th
          = t('.fee_type')
        %th
          = t('.name')
        %th
          = t('.tax_category')
        %th
          = t('.calculator')
        %th
          = t('.calculator_values')
        %th.actions
    %tbody
      = enterprise_fee_set_form.fields_for :collection, @collection do |f|
        = render "enterprise_fee", f:, enterprise_fee: f.object

  = enterprise_fee_set_form.submit t(:update)
