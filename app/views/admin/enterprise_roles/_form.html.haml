%tr#enterprise_role_form
  %td
    = select_tag "enterprise_role[user_id]", options_for_select(@users.map { |u| [u[:email], u[:id]] }), include_blank: true, form: "new_enterprise_role"
  %td= t('.manages')
  %td
    = select_tag "enterprise_role[enterprise_id]", options_for_select(@all_enterprises.map { |e| [e[:name], e[:id]] }), include_blank: true, form: "new_enterprise_role"
  %td.actions
    %input{ type: "submit", value: t(:create), form: "new_enterprise_role" }
    #enterprise_role_errors.errors
