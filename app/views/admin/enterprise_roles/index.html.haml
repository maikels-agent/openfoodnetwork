- content_for :page_title do
  =t :roles

= render 'admin/shared/users_sub_menu'

%div{ data: { controller: "filter-rows" } }
  %input.search{ placeholder: t(:search), data: { "filter-rows-target": "query", action: "input->filter-rows#filter" } }

  = form_with url: admin_enterprise_roles_path, id: "new_enterprise_role", data: { turbo: true }

  %table#enterprise-roles
    %tbody
      = render 'form'
      = render partial: 'enterprise_role', collection: @enterprise_roles
